Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Alpha: 0.65
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Static Map
      Topic:
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot Model
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: Nav2 2D Projection Debug - Not 3D Lidar
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Raw Front Lidar Points Debug
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /front_3d_lidar/lidar_points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Full 3D Lidar Map Points
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /front_3d_lidar/map_points
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Map Frame 2D Projection Cloud Debug
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /scan_map_cloud
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Executed Path
      Buffer Length: 1
      Color: 255; 80; 0
      Line Style: Lines
      Line Width: 0.08
      Topic:
        Value: /executed_path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Global Plan
      Buffer Length: 1
      Color: 0; 160; 255
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Local Plan
      Buffer Length: 1
      Color: 60; 255; 120
      Line Style: Lines
      Line Width: 0.04
      Topic:
        Value: /local_plan
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: AMCL Pose
      Topic:
        Value: /amcl_pose
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: Local Footprint
      Topic:
        Value: /local_costmap/published_footprint
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 22
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Name: Current View
    Pitch: 1.5708
    Target Frame: map
    Yaw: 1.5708
  Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 40
  Y: 40
